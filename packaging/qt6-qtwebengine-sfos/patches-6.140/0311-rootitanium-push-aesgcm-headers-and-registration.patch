+void rtpush_message_ex(const char *token, const char *body, int length, const char *encoding,
+                       const char *encryption, const char *cryptoKey)
+{
+    QByteArray meta;
+    if (encoding && *encoding && encryption && *encryption && cryptoKey && *cryptoKey)
+        meta = QByteArray(encoding) + '\n' + QByteArray(encryption) + '\n' + QByteArray(cryptoKey);
+    rtPushDeliver(2, token, QByteArray(body, length), meta);
+}
