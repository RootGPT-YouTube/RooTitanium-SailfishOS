diff --git a/src/core/rt_push.h b/src/core/rt_push.h
new file mode 100644
index 0000000..fbcfca2
--- /dev/null
+++ b/src/core/rt_push.h
@@ -0,0 +1,43 @@
+// Copyright (C) 2026 RooTitanium
+// SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+// RooTitanium: ponte fra il Web Push del motore e un distributore UnifiedPush
+// (Foghorn su SailfishOS). Il motore NON parla D-Bus: chiede all'app di
+// registrare un token e riceve dall'app endpoint e messaggi. La decifratura
+// (aes128gcm, RFC 8291) e il recapito al service worker restano di Chromium.
+//
+// ABI C apposta: l'app cerca questi simboli con dlsym e, se il motore e' vecchio
+// e non li ha, parte lo stesso (senza Web Push). Tutte le funzioni vanno
+// chiamate dal thread principale di Qt.
+
+#ifndef RT_PUSH_H
+#define RT_PUSH_H
+
+#include <QtWebEngineCore/qtwebenginecoreglobal.h>
+
+extern "C" {
+
+// motore -> app: registra token (vapid = chiave del sito in base64url, puo' essere vuota)
+typedef void (*RtPushRegisterCb)(const char *token, const char *vapid, const char *description);
+typedef void (*RtPushUnregisterCb)(const char *token);
+Q_WEBENGINECORE_EXPORT void rtpush_set_handlers(RtPushRegisterCb reg, RtPushUnregisterCb unreg);
+
+// app -> motore: risposte e messaggi del distributore
+Q_WEBENGINECORE_EXPORT void rtpush_endpoint(const char *token, const char *endpoint);
+Q_WEBENGINECORE_EXPORT void rtpush_failed(const char *token);
+Q_WEBENGINECORE_EXPORT void rtpush_message(const char *token, const char *body, int length);
+Q_WEBENGINECORE_EXPORT void rtpush_unregistered(const char *token);
+
+// motore -> app: clients.openWindow() di un service worker (tocco su una
+// notifica push). L'app apre l'URL in una scheda.
+typedef void (*RtOpenUrlCb)(const char *url);
+Q_WEBENGINECORE_EXPORT void rtpush_set_open_handler(RtOpenUrlCb cb);
+
+}
+
+namespace QtWebEngineCore {
+// interna: false = nessuna app in ascolto
+bool rtPushOpenUrl(const char *url);
+}
+
+#endif // RT_PUSH_H
diff --git a/src/core/rt_push_driver.cpp b/src/core/rt_push_driver.cpp
new file mode 100644
index 0000000..5d101c6
--- /dev/null
+++ b/src/core/rt_push_driver.cpp
@@ -0,0 +1,387 @@
+// Copyright (C) 2026 RooTitanium
+// SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+// RooTitanium: GCMDriver che al posto dei server Google usa un distributore
+// UnifiedPush tramite l'app (vedi rt_push.h).
+//
+// Il servizio Push di Chromium chiede un token via InstanceID; qui il token
+// restituito E' l'endpoint del distributore (push_messaging::CreateEndpoint lo
+// riconosce dal prefisso https:// e lo usa tale e quale). Le chiavi p256dh/auth
+// le genera e le conserva il GCMEncryptionProvider della classe base, che poi
+// decifra i messaggi aes128gcm: il distributore passa solo il corpo, ma in
+// aes128gcm sale e chiave del mittente stanno nel corpo.
+
+#include "rt_push.h"
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "components/gcm_driver/common/gcm_message.h"
+#include "components/gcm_driver/gcm_driver.h"
+#include "components/gcm_driver/crypto/gcm_encryption_provider.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "type_conversion.h"
+
+#include <QDir>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QList>
+#include <QSaveFile>
+
+#include <map>
+
+namespace {
+
+RtPushRegisterCb g_register = nullptr;
+RtPushUnregisterCb g_unregister = nullptr;
+RtOpenUrlCb g_openUrl = nullptr;
+
+// Quanto aspettare l'endpoint dopo la Register (Foghorn ne concede 20 al server).
+constexpr base::TimeDelta kEndpointTimeout = base::Seconds(30);
+
+} // namespace
+
+namespace gcm {
+
+class RtPushDriver;
+static RtPushDriver *g_driver = nullptr;
+
+// Messaggi arrivati prima che il profilo esista (avvio da sveglia D-Bus).
+struct RtPushQueued { int kind; QByteArray token, data; };
+static QList<RtPushQueued> &rtPushQueue()
+{
+    static QList<RtPushQueued> q;
+    return q;
+}
+
+class RtPushDriver : public GCMDriver, public InstanceIDHandler
+{
+public:
+    RtPushDriver(const base::FilePath &store_path,
+                 const scoped_refptr<base::SequencedTaskRunner> &blocking_task_runner)
+        : GCMDriver(store_path, blocking_task_runner)
+        , m_file(QtWebEngineCore::toQt(store_path.AppendASCII("rtpush.json").value()))
+    {
+        QDir().mkpath(QtWebEngineCore::toQt(store_path.value()));
+        load();
+        g_driver = this;
+        // In un task: il servizio Push aggiunge il suo handler subito DOPO
+        // averci creato, e un messaggio recapitato qui andrebbe perso.
+        const QList<RtPushQueued> queued = std::move(rtPushQueue());
+        rtPushQueue().clear();
+        for (const RtPushQueued &q : queued)
+            post(base::BindOnce(&RtPushDriver::deliver, m_weak.GetWeakPtr(), q.kind, q.token, q.data));
+    }
+
+    ~RtPushDriver() override
+    {
+        if (g_driver == this)
+            g_driver = nullptr;
+    }
+
+    base::WeakPtr<RtPushDriver> weakPtr() { return m_weak.GetWeakPtr(); }
+
+    // 0 = endpoint, 1 = fallita, 2 = messaggio, 3 = deregistrata
+    void deliver(int kind, const QByteArray &token, const QByteArray &data)
+    {
+        switch (kind) {
+        case 0: onEndpoint(token.toStdString(), data.toStdString()); break;
+        case 1: finishPending(token.toStdString(), std::string(), GCMClient::SERVER_ERROR, true); break;
+        case 2: onMessage(token.toStdString(), data.toStdString()); break;
+        case 3: onUnregistered(token.toStdString()); break;
+        }
+    }
+
+    // ---- InstanceIDHandler ----
+    void GetToken(const std::string &app_id, const std::string &authorized_entity,
+                  const std::string &scope, base::TimeDelta, GetTokenCallback callback) override
+    {
+        for (const auto &[token, e] : m_entries) {
+            if (e.app_id == app_id && e.entity == authorized_entity && e.scope == scope
+                && !e.endpoint.empty()) {
+                post(base::BindOnce(std::move(callback), e.endpoint, GCMClient::SUCCESS));
+                return;
+            }
+        }
+        if (!g_register) {
+            qWarning("RTPUSH: nessun distributore UnifiedPush collegato, sottoscrizione rifiutata");
+            post(base::BindOnce(std::move(callback), std::string(), GCMClient::SERVER_ERROR));
+            return;
+        }
+        const std::string token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+        m_entries[token] = Entry{ app_id, authorized_entity, scope, std::string() };
+        m_pending[token] = std::move(callback);
+        save();
+        qInfo("RTPUSH: Register token %s per %s", token.c_str(), app_id.c_str());
+        g_register(token.c_str(), authorized_entity.c_str(), "RooTitanium");
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(&RtPushDriver::finishPending, m_weak.GetWeakPtr(), token,
+                               std::string(), GCMClient::SERVER_ERROR, true),
+                kEndpointTimeout);
+    }
+
+    void ValidateToken(const std::string &app_id, const std::string &, const std::string &,
+                       const std::string &token, ValidateTokenCallback callback) override
+    {
+        bool valid = false;
+        for (const auto &[t, e] : m_entries)
+            if (e.app_id == app_id && e.endpoint == token)
+                valid = true;
+        post(base::BindOnce(std::move(callback), valid));
+    }
+
+    void DeleteToken(const std::string &app_id, const std::string &authorized_entity,
+                     const std::string &scope, DeleteTokenCallback callback) override
+    {
+        for (auto it = m_entries.begin(); it != m_entries.end();) {
+            const Entry &e = it->second;
+            if (e.app_id == app_id && (authorized_entity == "*" || e.entity == authorized_entity)
+                && (scope == "*" || e.scope == scope)) {
+                if (g_unregister)
+                    g_unregister(it->first.c_str());
+                m_pending.erase(it->first);
+                it = m_entries.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        save();
+        post(base::BindOnce(std::move(callback), GCMClient::SUCCESS));
+    }
+
+    void AddInstanceIDData(const std::string &app_id, const std::string &instance_id,
+                           const std::string &extra_data) override
+    {
+        m_iid[app_id] = { instance_id, extra_data };
+        save();
+    }
+
+    void RemoveInstanceIDData(const std::string &app_id) override
+    {
+        m_iid.erase(app_id);
+        save();
+    }
+
+    void GetInstanceIDData(const std::string &app_id, GetInstanceIDDataCallback callback) override
+    {
+        std::string id, extra;
+        auto it = m_iid.find(app_id);
+        if (it != m_iid.end()) {
+            id = it->second.first;
+            extra = it->second.second;
+        }
+        post(base::BindOnce(std::move(callback), id, extra));
+    }
+
+    // ---- GCMDriver ----
+    void ValidateRegistration(const std::string &, const std::vector<std::string> &,
+                              const std::string &, ValidateRegistrationCallback callback) override
+    {
+        post(base::BindOnce(std::move(callback), false));
+    }
+    void AddConnectionObserver(GCMConnectionObserver *) override {}
+    void RemoveConnectionObserver(GCMConnectionObserver *) override {}
+    GCMClient *GetGCMClientForTesting() const override { return nullptr; }
+    bool IsStarted() const override { return true; }
+    bool IsConnected() const override { return true; }
+    void GetGCMStatistics(GetGCMStatisticsCallback, ClearActivityLogs) override {}
+    void SetGCMRecording(const GCMStatisticsRecordingCallback &, bool) override {}
+    void SetAccountTokens(const std::vector<GCMClient::AccountTokenInfo> &) override {}
+    void UpdateAccountMapping(const AccountMapping &) override {}
+    void RemoveAccountMapping(const CoreAccountId &) override {}
+    base::Time GetLastTokenFetchTime() override { return base::Time(); }
+    void SetLastTokenFetchTime(const base::Time &) override {}
+    InstanceIDHandler *GetInstanceIDHandlerInternal() override { return this; }
+    void AddHeartbeatInterval(const std::string &, int) override {}
+    void RemoveHeartbeatInterval(const std::string &) override {}
+
+protected:
+    GCMClient::Result EnsureStarted(GCMClient::StartMode) override { return GCMClient::SUCCESS; }
+    // Le vecchie registrazioni con sender ID (GCM puro) non esistono senza Google.
+    void RegisterImpl(const std::string &app_id, const std::vector<std::string> &) override
+    {
+        post(base::BindOnce(&RtPushDriver::RegisterFinished, m_weak.GetWeakPtr(), app_id,
+                            std::string(), GCMClient::INVALID_PARAMETER));
+    }
+    void UnregisterImpl(const std::string &app_id) override
+    {
+        post(base::BindOnce(&RtPushDriver::RemoveEncryptionInfoAfterUnregister,
+                            m_weak.GetWeakPtr(), app_id, GCMClient::SUCCESS));
+    }
+    void SendImpl(const std::string &, const std::string &, const OutgoingMessage &) override {}
+    void RecordDecryptionFailure(const std::string &app_id, GCMDecryptionResult result) override
+    {
+        qWarning("RTPUSH: decifratura fallita per %s (risultato %d; aesgcm senza intestazioni?)",
+                 app_id.c_str(), int(result));
+    }
+
+private:
+    struct Entry { std::string app_id, entity, scope, endpoint; };
+
+    static void post(base::OnceClosure task)
+    {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(task));
+    }
+
+    void finishPending(const std::string &token, const std::string &endpoint,
+                       GCMClient::Result result, bool dropEntry)
+    {
+        auto it = m_pending.find(token);
+        if (it == m_pending.end())
+            return;
+        GetTokenCallback cb = std::move(it->second);
+        m_pending.erase(it);
+        if (dropEntry) {
+            qWarning("RTPUSH: registrazione %s non riuscita", token.c_str());
+            m_entries.erase(token);
+            save();
+            if (g_unregister)
+                g_unregister(token.c_str());
+        }
+        std::move(cb).Run(endpoint, result);
+    }
+
+    void onEndpoint(const std::string &token, const std::string &endpoint)
+    {
+        auto it = m_entries.find(token);
+        if (it == m_entries.end()) {
+            qWarning("RTPUSH: endpoint per token sconosciuto %s", token.c_str());
+            return;
+        }
+        // Un endpoint cambiato rende non valida la vecchia sottoscrizione
+        // (ValidateToken), e il sito la rifà alla prossima visita.
+        it->second.endpoint = endpoint;
+        save();
+        qInfo("RTPUSH: endpoint per %s", token.c_str());
+        finishPending(token, endpoint, GCMClient::SUCCESS, false);
+    }
+
+    void onMessage(const std::string &token, const std::string &body)
+    {
+        auto it = m_entries.find(token);
+        if (it == m_entries.end()) {
+            qWarning("RTPUSH: messaggio per token sconosciuto %s", token.c_str());
+            return;
+        }
+        IncomingMessage msg;
+        msg.sender_id = it->second.entity;
+        if (!body.empty()) {
+            msg.raw_data = body;
+            msg.data[GCMEncryptionProvider::kContentEncodingProperty] =
+                    GCMEncryptionProvider::kContentCodingAes128Gcm;
+        }
+        qInfo("RTPUSH: messaggio di %zu byte per %s", body.size(), it->second.app_id.c_str());
+        DispatchMessage(it->second.app_id, msg);
+    }
+
+    void onUnregistered(const std::string &token)
+    {
+        if (m_entries.erase(token))
+            save();
+        finishPending(token, std::string(), GCMClient::SERVER_ERROR, false);
+    }
+
+    void load()
+    {
+        QFile f(m_file);
+        if (!f.open(QIODevice::ReadOnly))
+            return;
+        const QJsonObject root = QJsonDocument::fromJson(f.readAll()).object();
+        const QJsonObject regs = root.value(QLatin1String("registrations")).toObject();
+        for (auto it = regs.begin(); it != regs.end(); ++it) {
+            const QJsonObject o = it.value().toObject();
+            m_entries[it.key().toStdString()] = Entry{
+                o.value(QLatin1String("app_id")).toString().toStdString(),
+                o.value(QLatin1String("entity")).toString().toStdString(),
+                o.value(QLatin1String("scope")).toString().toStdString(),
+                o.value(QLatin1String("endpoint")).toString().toStdString() };
+        }
+        const QJsonObject iid = root.value(QLatin1String("instance_ids")).toObject();
+        for (auto it = iid.begin(); it != iid.end(); ++it) {
+            const QJsonArray a = it.value().toArray();
+            m_iid[it.key().toStdString()] = { a.at(0).toString().toStdString(),
+                                              a.at(1).toString().toStdString() };
+        }
+    }
+
+    void save()
+    {
+        QJsonObject regs;
+        for (const auto &[token, e] : m_entries) {
+            regs.insert(QString::fromStdString(token), QJsonObject{
+                { QLatin1String("app_id"), QString::fromStdString(e.app_id) },
+                { QLatin1String("entity"), QString::fromStdString(e.entity) },
+                { QLatin1String("scope"), QString::fromStdString(e.scope) },
+                { QLatin1String("endpoint"), QString::fromStdString(e.endpoint) } });
+        }
+        QJsonObject iid;
+        for (const auto &[app, d] : m_iid)
+            iid.insert(QString::fromStdString(app),
+                       QJsonArray{ QString::fromStdString(d.first), QString::fromStdString(d.second) });
+        QSaveFile f(m_file);
+        if (!f.open(QIODevice::WriteOnly))
+            return;
+        f.write(QJsonDocument(QJsonObject{ { QLatin1String("registrations"), regs },
+                                           { QLatin1String("instance_ids"), iid } }).toJson());
+        // dentro ci sono gli endpoint: chi li conosce puo' mandare push ai siti
+        f.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+        f.commit();
+    }
+
+    QString m_file;
+    std::map<std::string, Entry> m_entries;          // token -> registrazione
+    std::map<std::string, GetTokenCallback> m_pending;
+    std::map<std::string, std::pair<std::string, std::string>> m_iid;
+    base::WeakPtrFactory<RtPushDriver> m_weak{ this };
+};
+
+std::unique_ptr<GCMDriver> CreateRtPushDriver(
+        const base::FilePath &store_path,
+        const scoped_refptr<base::SequencedTaskRunner> &blocking_task_runner)
+{
+    return std::make_unique<RtPushDriver>(store_path, blocking_task_runner);
+}
+
+} // namespace gcm
+
+static void rtPushDeliver(int kind, const QByteArray &token, const QByteArray &data)
+{
+    if (gcm::g_driver)
+        content::GetUIThreadTaskRunner({})->PostTask(
+                FROM_HERE, base::BindOnce(&gcm::RtPushDriver::deliver,
+                                          gcm::g_driver->weakPtr(), kind, token, data));
+    else
+        gcm::rtPushQueue().append({ kind, token, data });
+}
+
+extern "C" {
+
+void rtpush_set_handlers(RtPushRegisterCb reg, RtPushUnregisterCb unreg)
+{
+    g_register = reg;
+    g_unregister = unreg;
+}
+
+void rtpush_endpoint(const char *token, const char *endpoint) { rtPushDeliver(0, token, endpoint); }
+void rtpush_failed(const char *token) { rtPushDeliver(1, token, QByteArray()); }
+void rtpush_message(const char *token, const char *body, int length) { rtPushDeliver(2, token, QByteArray(body, length)); }
+void rtpush_unregistered(const char *token) { rtPushDeliver(3, token, QByteArray()); }
+
+void rtpush_set_open_handler(RtOpenUrlCb cb) { g_openUrl = cb; }
+
+}
+
+bool QtWebEngineCore::rtPushOpenUrl(const char *url)
+{
+    if (!g_openUrl)
+        return false;
+    g_openUrl(url);
+    return true;
+}
