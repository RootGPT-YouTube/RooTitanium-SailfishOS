 #include <QSharedPointer>
 
 namespace QtWebEngineCore {
 
+// RooTitanium (patch 0310), vedi rt_push.h
+static std::string g_rtCurrentId;                        // id durante presentNotification
+static content::BrowserContext *g_rtDiskContext = nullptr;
+static QList<QPair<std::string, GURL>> &rtPendingClicks()
+{
+    static QList<QPair<std::string, GURL>> q;
+    return q;
+}
+
+static void rtDispatchClick(content::BrowserContext *context, const std::string &id, const GURL &origin)
+{
+    auto inst = content::NotificationEventDispatcher::GetInstance();
+    if (!inst) {
+        rtPushOpenUrl(origin.spec().c_str());
+        return;
+    }
+    qInfo("[rtpush] click alla notifica %s di %s (processo precedente)", id.c_str(), origin.spec().c_str());
+    inst->DispatchNotificationClickEvent(
+            context, id, origin, std::nullopt, std::nullopt,
+            base::BindOnce([](GURL origin, content::PersistentNotificationStatus status) {
+                // consegnato (anche con waitUntil respinto): ci pensa il sito
+                if (status == content::PersistentNotificationStatus::kSuccess
+                    || status == content::PersistentNotificationStatus::kWaitUntilRejected)
+                    return;
+                qWarning("[rtpush] click non consegnato (stato %d): apro l'origine", int(status));
+                rtPushOpenUrl(origin.spec().c_str());
+            }, origin));
+}
+
+void rtNotificationProfileOnDisk(content::BrowserContext *context)
+{
+    g_rtDiskContext = context;
+    const auto pending = std::move(rtPendingClicks());
+    rtPendingClicks().clear();
+    for (const auto &c : pending)
+        rtDispatchClick(context, c.first, c.second);
+}
