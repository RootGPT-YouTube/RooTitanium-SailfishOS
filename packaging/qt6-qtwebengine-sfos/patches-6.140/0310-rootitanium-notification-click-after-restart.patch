+
+extern "C" {
+
+const char *rtpush_notification_current_id(void)
+{
+    return QtWebEngineCore::g_rtCurrentId.c_str();
+}
+
+void rtpush_notification_click(const char *id, const char *origin)
+{
+    Q_ASSERT(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+    if (!id || !*id || !origin || !*origin)
+        return;
+    const GURL url(origin);
+    if (QtWebEngineCore::g_rtDiskContext)
+        QtWebEngineCore::rtDispatchClick(QtWebEngineCore::g_rtDiskContext, id, url);
+    else
+        QtWebEngineCore::rtPendingClicks().append({ std::string(id), url });
+}
