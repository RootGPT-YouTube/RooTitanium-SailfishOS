 typedef void (*RtOpenUrlCb)(const char *url);
 Q_WEBENGINECORE_EXPORT void rtpush_set_open_handler(RtOpenUrlCb cb);
 
+// Patch 0310: tocco su una notifica di un processo PRECEDENTE (app riavviata
+// dal tocco). Chromium tiene le notifiche dei service worker nel database del
+// profilo: con il loro id il click arriva al sito come se l'app non si fosse
+// mai chiusa, e il sito apre la sua pagina (clients.openWindow).
+// - rtpush_notification_current_id: valido SOLO dentro presentNotification
+//   (la emette il motore in modo sincrono): id persistente della notifica che
+//   si sta consegnando, "" se non ha un service worker dietro.
+// - rtpush_notification_click: consegna il click; si accoda finche' il profilo
+//   su disco non esiste (l'app parte off-the-record). Se il sito non puo'
+//   riceverlo (dati spariti, service worker assente) apre l'origine con
+//   l'handler di rtpush_set_open_handler.
+Q_WEBENGINECORE_EXPORT const char *rtpush_notification_current_id(void);
+Q_WEBENGINECORE_EXPORT void rtpush_notification_click(const char *id, const char *origin);
+
 }
 
+namespace content { class BrowserContext; }
+
 namespace QtWebEngineCore {
 // interna: false = nessuna app in ascolto
 bool rtPushOpenUrl(const char *url);
+// interna (0310): il profilo e' passato su disco, i click accodati possono partire
+void rtNotificationProfileOnDisk(content::BrowserContext *context);
 }
 
 #endif // RT_PUSH_H
