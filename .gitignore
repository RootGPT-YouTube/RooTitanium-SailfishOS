# Clone upstream di terze parti (riproducibile, ~3.6 GB con submodule Chromium)
# git clone --recursive https://github.com/sailfishos-chum/qt6-qtwebengine
/qt6-qtwebengine/

# Alberi di build per-arch (generati con sfdk/mb2)
/harbour-rootmium_*/

# Artefatti
*.rpm
RPMS/

# Cartella di lavoro (artefatti riproducibili, backup SDK, bundle) — mai committare
/scratch/

# moc generato compilando webengine-smoke (sb2)
smoke-test/main.moc

# Log del device tirato giu' per diagnosi: puo' contenere gli URL visitati
# dall'utente — il repo e' PUBBLICO, non deve entrarci mai.
/rootitanium.log

# Specchio delle note di lavoro (skill /memory_rootitanium): contiene IP privati
# dei device e dettagli di rete di casa. Copia locale, mai nel repo pubblico.
/memory/

# Clone upstream Qt per l'aggiornamento del motore (shallow, ~decine di GB)
/qtwebengine-6.8.4/
